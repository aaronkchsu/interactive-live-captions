# Optional. Demo mode and browser speech recognition work without an API key.
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-live-transcribe
TRANSLATION_MODEL=gpt-6-luna
VISION_MODEL=gpt-6-luna
AUDIO_OBSERVATION_MODEL=gpt-audio-1.5
COMMENTARY_MODEL=gpt-6-luna
PORT=4317
# Optional Twitch credentials; alternatively enter them in the Connections dialog.
# Use a user access token with user:read:chat. Never put tokens in an overlay URL.
TWITCH_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=
TWITCH_CHANNEL=

# Optional live speech-to-speech adapter
DUBBING_MODEL=gpt-realtime-translate
